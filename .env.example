# Скопируйте в .env и заполните для локального теста.
# В GitHub Actions эти же значения приходят из Secrets — .env туда не попадает.

COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

M2M_USERNAME=
M2M_PASSWORD=
M2M_TOKEN=

# Значения из setup_drive.py (см. README, шаг 4)
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=

AOI_GEOJSON_BLOB=config/All_ROI_2026_2.geojson
GRID_GEOJSON_BLOB=config/GRID_Landsat.geojson

SMTP_USER=
SMTP_APP_PASSWORD=
NOTIFY_EMAIL=

TIMEZONE=Europe/Moscow
MAX_PARALLEL_AOI=8

# Опционально: переопределить дату мониторинга (по умолчанию — сегодня)
# MONITOR_DATE=2026-08-01
